{
  "ConnectionStrings": {
    "DefaultConnection": "Server=mysql;Database=CRM;Uid=root;Pwd=${MYSQL_ROOT_PASSWORD};Port=3306;",
    "Redis": "redis:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "SecretKey": "5037baaf-7201-4b9c-b4dc-6c51306b18fa"
  },
  "HybridCache": {
    "DefaultExpirationTime": "00:10:00"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki:3100",
          "labels": [
            {
              "key": "app",
              "value": "dotnet-api"
            },
            {
              "key": "env",
              "value": "docker"
            }
          ],
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  },
  "DistributedTracing": {
    "Jaeger": {
      "ServiceName": "CRM",
      "Host": "jaeger",
      "Port": 6831,
      "Endpoint": "http://jaeger:14268/api/traces"
    }
  },
  "Keycloak": {
    "AuthorityHost": "http://keycloak:8080",
    "Realm": "fiap-realm",
    "ClientId": "fiap-api-client",
    "ClientSecret": "${KEYCLOAK_CLIENT_SECRET}",
    "Admin": {
      "ClientId": "fiap-api-client",
      "ClientSecret": "${KEYCLOAK_CLIENT_SECRET}"
    }
  },
  "AllowedHosts": "*"
}
