{
  "ConnectionStrings": {
    "CRMConnection": "Server=localhost;Database=CRM;Uid=root;Pwd=admin;Port=3306;",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HybridCache": {
    "DefaultExpirationTime": "00:10:00"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki:3100",
          "labels": [
            {
              "key": "app-crm",
              "value": "dotnet-api"
            },
            {
              "key": "env",
              "value": "docker"
            }
          ],
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  },
  "DistributedTracing": {
    "Jaeger": {
      "ServiceName": "CRM",
      "Host": "jaeger",
      "Port": 6831,
      "Endpoint": "http://jaeger:14268/api/traces"
    }
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/fiap-realm",
    "AuthorityHost": "http://localhost:8080",
    "Realm": "fiap-realm",
    "ClientId": "fiap-api-client",
    "ClientSecret": "***REMOVED***",
    "Admin": {
      "ClientId": "fiap-api-client",
      "ClientSecret": "***REMOVED***"
    }
  },
  "ServiceBus": {
    "Region": "sa-east-1",
    "CRMQueueName": "crm-queue",
    "LambdaQueueName": "lambda-queue"
  },
  "ExternalServices": {
    "FCGUrl": "https://localhost:7242"
  }
}
