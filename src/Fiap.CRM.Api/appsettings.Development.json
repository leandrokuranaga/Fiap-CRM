{
  "ConnectionStrings": {
    "CRMConnection": "Server=localhost;Database=CRM;Uid=root;Pwd=admin;Port=3306;",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HybridCache": {
    "DefaultExpirationTime": "00:10:00"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }   
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  },
  "DistributedTracing": {
    "Jaeger": {
      "ServiceName": "CRM",
      "Host": "jaeger",
      "Port": 6831,
      "Endpoint": "http://jaeger:14268/api/traces"
    }
  },
  "ServiceBus": {
    "Region": "sa-east-1",
    "CRMQueueName": "crm-queue",
    "LambdaQueueName": "lambda-queue"
  },
  "ExternalServices": {
    "FCGUrl": "https://localhost:7242"
  }
}
